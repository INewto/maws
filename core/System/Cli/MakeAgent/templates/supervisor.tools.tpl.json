// Инструменты надзирателя — его агенты. Объявление то же, что у обычного инструмента:
// имя, описание и схема входа. По описанию модель решает, кого позвать и с какой задачей.
// Формат — JSON5: комментарии разрешены, читает их Ai::listTools.
//
// Пример записи:
// {
//     "name": "sayHelloAgent",
//     "description": "Агент, который здоровается. Принимает задачу и отвечает приветствием",
//     "inputSchema": {
//         "type": "object",
//         "properties": {
//             "task": {
//                 "type": "string",
//                 "description": "задача для агента"
//             }
//         },
//         "required": ["task"]
//     }
// }
[]
