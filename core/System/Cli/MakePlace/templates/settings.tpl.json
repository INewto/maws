// Что место объявляет: свои инструменты, нужды в чужих и политику кэша.
// list — инструменты этого места; needs — что нужно из других мест, "Направление/Место" → имена.
// Формат — JSON5: комментарии разрешены, читает их Tools::of.
{
  "tools": {
    "list": []
  }

  // Кэш выключен, пока ключа нет: страница уходит с no-store.
  // ttl — сколько секунд ответ свежий; 0 — хранить, но каждый раз сверять (no-cache + ETag).
  // scope — "private" (по умолчанию: копию хранит только браузер) или "public"
  // (общий кэш вправе отдать копию другим — только если в теле нет ничего личного).
  // , "cache": { "ttl": 60, "scope": "private" }
}
